<Window x:Class="WarungRafi.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Warung Rafi — Kasir" Width="1320" Height="850" MinWidth="900" MinHeight="620" Background="{StaticResource AppBackground}" Foreground="{StaticResource Ink}"
 FontFamily="Segoe UI" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnWorkspaceKeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
 <Grid x:Name="RootLayout">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Border Background="{StaticResource RailBrush}" BorderBrush="{StaticResource Forest}" BorderThickness="0,0,0,3" Padding="22,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="Assets/logo.png" Width="50" Height="50" Stretch="Uniform" Margin="0,0,12,0" AutomationProperties.AutomationId="BrandLogo" AutomationProperties.Name="Logo Asoyyy"/>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="Warung Rafi" Foreground="White" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="ASOYYY GROUP" Foreground="#C4BFAF" FontSize="10" Margin="0,4,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel x:Name="Navigation" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="SellNav" Content="Jualan" Click="ShowSelling" Style="{StaticResource NavigationButton}" Margin="0,0,8,0"/>
     <Button x:Name="HeldNav" Content="Ditunda" Click="ShowHeld" Style="{StaticResource NavigationButton}" Margin="0,0,8,0"/>
     <Button x:Name="HistoryNav" Content="Riwayat" Click="ShowHistory" Style="{StaticResource NavigationButton}" Margin="0,0,8,0"/>
     <Button x:Name="SettingsButton" Content="Pengaturan" Click="OpenSettings" Style="{StaticResource NavigationButton}"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="#EAE6DD" Padding="22,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="HeaderDate" VerticalAlignment="Center"><TextBlock Text="Wedangan Dan Aneka Nasi Sayur Murah" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
    <TextBlock x:Name="DateLabel" Grid.Column="1" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    <Border x:Name="PreviewNotice" Grid.Column="2" Visibility="Collapsed" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="PreviewBadge" FontSize="10" Foreground="{StaticResource WarningBrush}"/></Border>
   </Grid>
  </Border>
  <ContentControl x:Name="MainContent" Grid.Row="2" Margin="22,16,22,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <Grid Grid.Row="3" Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="Menyiapkan penyimpanan lokal…"/>
    <TextBlock x:Name="SheetsStatus" FontSize="10" Foreground="{StaticResource Muted}" Text="Sheets menunggu koneksi" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
   </StackPanel><Button x:Name="DemoQris" Grid.Column="1" Content="Coba QRIS" Click="SimulateQris" Visibility="Collapsed" FontSize="12" MinHeight="30" Padding="10,2"/>
  </Grid>
  <Border x:Name="Toast" Grid.RowSpan="4" Panel.ZIndex="10" Width="350" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,48" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource Forest}" BorderThickness="4,0,0,0" CornerRadius="12" Padding="20,16" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
   <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
   <StackPanel><TextBlock x:Name="ToastTitle" Text="✓  Pembayaran QRIS diterima" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Forest}"/><TextBlock x:Name="ToastAmount" FontSize="28" FontWeight="SemiBold" Foreground="White" Margin="0,5,0,4"/><TextBlock x:Name="ToastTime" FontSize="12" Foreground="#BCB8AA"/></StackPanel>
  </Border>
 </Grid>
</Window>
