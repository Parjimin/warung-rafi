<Window x:Class="WarungRafi.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Warung Rafi — Kasir" Width="1320" Height="850" MinWidth="900" MinHeight="620" Background="#E3EAE7" Foreground="#243D33"
 FontFamily="Segoe UI Variable Text, Segoe UI" Loaded="OnLoaded" Closing="OnClosing" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootLayout" Margin="20,12,20,10">
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#CDDCD5" Offset="0"/><GradientStop Color="#E8EDEB" Offset="0.5"/><GradientStop Color="#CFD9E0" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Border Grid.RowSpan="3" IsHitTestVisible="False"><Border.Background><RadialGradientBrush Center="0.8,0.2" GradientOrigin="0.8,0.2" RadiusX="0.75" RadiusY="0.8"><GradientStop Color="#CFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Border.Background></Border>
    <Border BorderBrush="#5FFFFFFF" BorderThickness="1" Padding="14,8" CornerRadius="20">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F01B3430" Offset="0"/><GradientStop Color="#ED314D47" Offset="1"/></LinearGradientBrush></Border.Background>
      <Border.Effect><DropShadowEffect Color="#233C34" BlurRadius="20" ShadowDepth="5" Opacity="0.16"/></Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
          <Border Background="#1AFFFFFF" BorderBrush="#50FFFFFF" BorderThickness="1" Width="42" Height="42" CornerRadius="13" Margin="0,0,12,0">
            <TextBlock Text="WR" FontWeight="Bold" FontSize="23" Foreground="#F6F5EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Warung Rafi" FontFamily="Georgia" FontWeight="Normal" FontSize="25" Foreground="#F3F7F4"/>
            <TextBlock Text="Wedangan &amp; aneka nasi sayur" FontSize="11" Foreground="#BECEC7" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#19FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="14" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel x:Name="Navigation" Orientation="Horizontal">
            <Button x:Name="SellNav" Content="Jualan" Click="ShowSelling" FontSize="16" MinHeight="44" Padding="16,8" Margin="0,0,4,0"/>
            <Button x:Name="HeldNav" Content="Ditunda" Click="ShowHeld" FontSize="16" MinHeight="44" Padding="16,8" Margin="0,0,4,0"/>
            <Button x:Name="HistoryNav" Content="Riwayat" Click="ShowHistory" FontSize="16" MinHeight="44" Padding="16,8" Margin="0,0,4,0"/>
            <Button x:Name="CashNav" Content="Kas hari ini" Click="ShowCash" FontSize="16" MinHeight="44" Padding="16,8"/>
          </StackPanel>
        </Border>
        <StackPanel x:Name="HeaderDate" Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock Text="WARUNG RAFI / KASIR" FontSize="10" FontWeight="SemiBold" Foreground="#BECEC7" HorizontalAlignment="Right" Margin="0,0,0,4"/>
          <TextBlock x:Name="DateLabel" FontSize="13" Foreground="#F3F7F4"/>
        </StackPanel>
      </Grid>
    </Border>
    <ContentControl x:Name="MainContent" Grid.Row="1" Margin="0,18,0,8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="SheetsStatus" FontSize="11" Foreground="#647268" Text="Sheets menunggu koneksi"/><TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" Foreground="#647268" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="Menyiapkan penyimpanan lokal…"/></StackPanel>
      <Button x:Name="DemoQris" Grid.Column="1" Content="Coba QRIS" Click="SimulateQris" Visibility="Collapsed" FontSize="12" MinHeight="28" Padding="10,2"/>
      <Button x:Name="SettingsButton" Grid.Column="2" Content="Pengaturan" Click="OpenSettings" FontSize="12" MinHeight="28" Padding="10,2"/>
      <Border Grid.Column="3" Background="#80FFFFFF" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock x:Name="PreviewBadge" Text="VERSI UJI · MENU DUMMY" Foreground="#52635D" FontSize="10" FontWeight="SemiBold"/>
      </Border>
    </Grid>
    <Border x:Name="Toast" Grid.RowSpan="2" Panel.ZIndex="10" Width="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"
            Background="#234F3F" CornerRadius="14" Padding="18,4" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
      <StackPanel>
        <TextBlock x:Name="ToastTitle" Text="Pembayaran QRIS diterima" FontSize="18" Foreground="White"/>
        <TextBlock x:Name="ToastAmount" FontSize="26" FontWeight="Bold" Foreground="White"/>
        <TextBlock x:Name="ToastTime" FontSize="13" Foreground="#DFEEE2"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
