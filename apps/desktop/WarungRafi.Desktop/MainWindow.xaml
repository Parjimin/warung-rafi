<Window x:Class="WarungRafi.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Warung Rafi — Kasir" Width="1280" Height="860" MinWidth="960" MinHeight="680" Background="#F7F5EE" FontFamily="Segoe UI" Loaded="OnLoaded" Closing="OnClosing">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="WARUNG RAFI" FontSize="32" FontWeight="Bold"/>
        <TextBlock Text="Wedangan dan aneka nasi sayur" FontSize="18" Margin="0,5"/>
        <TextBlock Text="VERSI UJI · MENU DAN HARGA DUMMY" FontSize="12" Foreground="#836541"/>
      </StackPanel>
      <Border x:Name="Toast" Grid.Column="1" Background="#194D3A" CornerRadius="18" Padding="16" Visibility="Hidden" IsHitTestVisible="False" Focusable="False">
        <StackPanel>
          <TextBlock Text="Pembayaran QRIS diterima" FontSize="19" Foreground="White"/>
          <TextBlock x:Name="ToastAmount" FontSize="30" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="ToastTime" FontSize="16" Foreground="#D4E9DA"/>
        </StackPanel>
      </Border>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal">
      <Button Content="Jualan" Click="ShowSelling"/>
      <Button x:Name="HeldNav" Content="Pesanan Ditunda" Click="ShowHeld"/>
      <Button Content="Riwayat" Click="ShowHistory"/>
      <Button Content="Kas Hari Ini" Click="ShowCash"/>
    </StackPanel>
    <ContentControl x:Name="MainContent" Grid.Row="2" Margin="0,14,0,8"/>
    <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="15" Padding="6" Text="Menyiapkan penyimpanan lokal…"/>
  </Grid>
</Window>
