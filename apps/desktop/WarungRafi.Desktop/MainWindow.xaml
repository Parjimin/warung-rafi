<Window x:Class="WarungRafi.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Warung Rafi — Kasir" Width="1320" Height="850" MinWidth="900" MinHeight="620" Background="#F2F4EF" Foreground="#243D33"
 FontFamily="Segoe UI" Loaded="OnLoaded" Closing="OnClosing" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootLayout" Margin="20,12,20,10" Background="#F2F4EF">
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Border BorderBrush="#DDE4DA" BorderThickness="0,0,0,1" Padding="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
          <Border Background="#234F3F" Width="42" Height="42" CornerRadius="13" Margin="0,0,12,0">
            <TextBlock Text="wr" FontWeight="Bold" FontSize="23" Foreground="#F6F5EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Warung Rafi" FontWeight="Bold" FontSize="23"/>
            <TextBlock Text="Wedangan &amp; aneka nasi sayur" FontSize="12" Foreground="#647268" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#E8EDE5" CornerRadius="14" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel x:Name="Navigation" Orientation="Horizontal">
            <Button x:Name="SellNav" Content="Jualan" Click="ShowSelling" FontSize="16" MinHeight="44" Padding="16,8" Margin="0,0,4,0"/>
            <Button x:Name="HeldNav" Content="Ditunda" Click="ShowHeld" FontSize="16" MinHeight="44" Padding="16,8" Margin="0,0,4,0"/>
            <Button x:Name="HistoryNav" Content="Riwayat" Click="ShowHistory" FontSize="16" MinHeight="44" Padding="16,8" Margin="0,0,4,0"/>
            <Button x:Name="CashNav" Content="Kas hari ini" Click="ShowCash" FontSize="16" MinHeight="44" Padding="16,8"/>
          </StackPanel>
        </Border>
        <StackPanel x:Name="HeaderDate" Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock Text="KASIR UTAMA" FontSize="10" FontWeight="SemiBold" Foreground="#647268" HorizontalAlignment="Right" Margin="0,0,0,4"/>
          <TextBlock x:Name="DateLabel" FontSize="13" Foreground="#3C5144"/>
        </StackPanel>
      </Grid>
    </Border>
    <ContentControl x:Name="MainContent" Grid.Row="1" Margin="0,18,0,8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" Foreground="#647268" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="Menyiapkan penyimpanan lokal…"/>
      <Border Grid.Column="1" Background="#EEE7D9" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock Text="VERSI UJI · MENU DUMMY" Foreground="#806443" FontSize="10" FontWeight="SemiBold"/>
      </Border>
    </Grid>
    <Border x:Name="Toast" Grid.RowSpan="2" Panel.ZIndex="10" Width="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"
            Background="#234F3F" CornerRadius="16" Padding="20,16" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
      <StackPanel>
        <TextBlock Text="Pembayaran QRIS diterima" FontSize="19" Foreground="White"/>
        <TextBlock x:Name="ToastAmount" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,5"/>
        <TextBlock x:Name="ToastTime" FontSize="16" Foreground="#DFEEE2"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
