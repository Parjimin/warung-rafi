# Server-side only. Never commit .env.local. Create a dedicated Supabase Auth admin.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_ID=
# Generate random 32+ byte token; configure same token on the one laptop.
DEVICE_API_TOKEN=
DEVICE_ID=kasir-utama
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_MERCHANT_ID=
# Optional Google Sheets exporter. A dedicated empty spreadsheet must be shared
# with this service account as Editor. Keep the JSON on the server only.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# A separate random 32+ character secret for POST /api/jobs/sheets.
EXPORT_RUNNER_TOKEN=
